<?xml version="1.0" encoding="utf-8"?>
<!--
  This app stores a Google refresh token in the Keystore-backed store.
  NEVER allow it to be backed up or transferred off the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="phonebridge_secure.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="phonebridge_secure.xml" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>

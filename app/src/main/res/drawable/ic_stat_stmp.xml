<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar icon: the STMP mark, reduced to what survives 24dp.

  **Not the launcher artwork.** That is a distressed rubber stamp with the word STMP across it —
  the texture and the lettering are the identity at 48dp and above, and both are gone by 24dp.
  Rendered and checked: at status-bar size it is a black rectangle with an unreadable smear
  inside. The launcher's monochrome layer has the same problem, which is why it is not reused
  here.

  So this is the SILHOUETTE only: the stamp's outline, which is the one part that survives. The
  platform tints a small icon by alpha, so it must be pure white with transparency — any colour
  here is discarded and only the shape arrives.

  Drawn at 24×24 with a 1dp safe margin: the base slab spans x 3..21, the neck tapers to the
  handle, and no stroke is thinner than ~1.6dp so the shape does not break up at mdpi.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- The base: the slab the stamp lands on. Rounded so it reads as a stamp, not a bar. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.4,15.6 L19.6,15.6 A1.4,1.4 0 0 1 21,17 L21,18.6 A1.4,1.4 0 0 1 19.6,20 L4.4,20 A1.4,1.4 0 0 1 3,18.6 L3,17 A1.4,1.4 0 0 1 4.4,15.6 Z" />

    <!-- The neck: narrower than both the base and the handle, which is what says "stamp". -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.2,15.8 L9.4,10.6 L14.6,10.6 L15.8,15.8 Z" />

    <!-- The handle: a rounded cap. Its width is the widest part above the base. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.6,4.2 L13.4,4.2 A2.2,2.2 0 0 1 15.6,6.4 L15.6,8.8 A2.2,2.2 0 0 1 13.4,11 L10.6,11 A2.2,2.2 0 0 1 8.4,8.8 L8.4,6.4 A2.2,2.2 0 0 1 10.6,4.2 Z" />
</vector>

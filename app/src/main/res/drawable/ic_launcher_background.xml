<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon BACKGROUND layer.

  A full-bleed solid, not the artwork. The launcher composites it under the
  foreground and applies its own mask, so anything drawn here must simply fill
  the whole 108dp canvas — shapes belong in the foreground layer.

  stmp_launcher_bg is the launcher paper colour (values/colors.xml), so the icon
  shares a palette with every screen behind it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/stmp_launcher_bg"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  STMP launcher icon: a rubber-stamp mark.

  Rewritten with ONLY universally-safe path data (absolute M / L / C, no arcs, no
  relative m/q shorthands) because the first hand-drawn version used arc/quadratic
  syntax that some Android vector parsers reject at inflate time — which is what
  made the install report "corrupt" and the icon blank.

  Design: warm paper square, a deep red circular ink stamp, and the letters "STMP"
  built from simple rectangles (no font dependency at icon time). Two flat circles
  read as the inked rim without any arc path tricks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Paper background. -->
    <path
        android:fillColor="#FFF5EEDF"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <!-- Ink stamp disc: a filled circle approximated with four cubic curves.
         Centred at (54,54), radius 30. -->
    <path
        android:fillColor="#FFB23A2F"
        android:pathData="M54,24 C70.57,24 84,37.43 84,54 C84,70.57 70.57,84 54,84 C37.43,84 24,70.57 24,54 C24,37.43 37.43,24 54,24 Z" />

    <!-- Scraped inner rim: a paper-coloured ring, radius ~22, drawn as a stroke so the
         ink reads as a stamp rather than a solid disc. -->
    <path
        android:strokeColor="#FFF5EEDF"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:pathData="M54,32 C66.15,32 76,41.85 76,54 C76,66.15 66.15,76 54,76 C41.85,76 32,66.15 32,54 C32,41.85 41.85,32 54,32 Z" />

    <!-- STMP letterforms, paper-coloured, built from plain rectangles.
         S -->
    <path android:fillColor="#FFF5EEDF"
        android:pathData="M39,46 L51,46 L51,49 L42,49 L42,52 L48,52 L49,52 L49,55 L41,55 L41,53 L47,53 L47,52 L46,52 L42,52 L42,58 L51,58 L51,55 L51,52 L51,49 L51,46 Z" />
    <!-- T -->
    <path android:fillColor="#FFF5EEDF"
        android:pathData="M55,46 L70,46 L70,49 L64,49 L64,58 L61,58 L61,49 L55,49 Z" />
    <!-- M -->
    <path android:fillColor="#FFF5EEDF"
        android:pathData="M39,64 L42,64 L44,69 L46,64 L48,64 L48,70 L46,70 L46,67 L45,70 L43,70 L42,67 L42,70 L39,70 Z" />
    <!-- P -->
    <path android:fillColor="#FFF5EEDF"
        android:pathData="M51,64 L54,64 L54,70 L51,70 Z" />
</vector>

<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Material 3 base. Required by MaterialButton: a Material component inflates
      against a Theme.Material3 theme and throws at runtime on an AppCompat-only
      parent. Everything else (colours, metrics) is owned by `ui/Theme.kt`, so this
      file stays a thin wrapper — one place to change the base, not two.
    -->
    <!--
      **Light, not DayNight.** This app is one hard-coded palette: cream paper, brown ink.

      `DayNight` made Material widgets follow the PHONE's night setting, so on a dark-mode phone
      every dialog, EditText and button drew dark grey against a cream sheet — the "dark mode /
      light mode mismatch" reported 2026-11-04. There is no dark palette to switch to, so the
      correct parent is the one that cannot switch: Light.

      If a real dark theme is ever wanted, it needs a full palette in `ui/Theme.kt` first — at
      which point this line becomes DayNight again and both branches must exist.
    -->
    <style name="Theme.STMP" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/pb_bg</item>
        <item name="colorPrimary">@color/pb_accent</item>
    </style>

    <style name="Theme.STMP.Approval" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowBackground">@color/pb_bg</item>
        <item name="colorPrimary">@color/pb_accent</item>
    </style>
</resources>

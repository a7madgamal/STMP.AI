<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse, not dataSync: this is a persistent local HTTP server, not a sync job.
         dataSync carries a hard 6-hour/24h cap on Android 15+ (targetSdk 35), after which
         the system throws ForegroundServiceDidNotStopInTimeException and kills the process. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Doze/app-standby would still stop the server; the user grants an exemption from the
         in-app checklist. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Auto-start after a reboot. Without this permission the BOOT_COMPLETED receiver is
         simply never delivered, so the bridge stays down until someone opens the app — which is
         exactly what happened on 2026-10-25 when the phone rebooted at ~05:40 and nothing
         restarted it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Watching for the tailnet COMING BACK. Without this the app cannot tell when a network
         change makes a 100.x address available, so turning Tailscale back on left the bridge
         down until someone opened the app (2026-10-25). Normal permission: granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required for the approval haptics (alert/SoundAlerts.kt). Without it
         VibrationEffect silently does nothing - a request you were meant to FEEL
         would be silent, which is the exact failure the alerts exist to fix. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Contact search. A RUNTIME permission, so declaring it grants nothing: the app must ask,
         and `GET /contacts` answers 503 contacts_unavailable until a human taps the prompt on the
         PhoneBridge screen. Declared here because a route cannot ask for a permission — only an
         Activity can — so the declaration and the refusal code are the two halves of one design. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

        <!--
          Keep config across an uninstall, without ever keeping a secret.

          `hasFragileUserData` makes Android show a "keep app data?" checkbox on uninstall. If
          the human ticks it, `filesDir` and SharedPreferences survive: the gate policy and its
          rules, the audit log, and the account email. That is the config worth keeping.

          SECRETS CANNOT SURVIVE, by construction rather than by exclusion: the vault's wrapping
          key lives in the AndroidKeyStore, and the Keystore entry is deleted on uninstall no
          matter what this flag says. Restoring the prefs alone therefore restores an unopenable
          vault — which is why `VaultState.ORPHANED` had to be added in this same release. Without
          that guard, a kept-config reinstall produced a vault that failed every unlock forever
          and offered no reset, because `vaultKey()` quietly mints a fresh key and the old blob
          then fails its GCM tag.

          Not a backup: this keeps data on THIS phone across a reinstall, and sends nothing off
          the device. `allowBackup` stays false, so the refresh token still never leaves.
        -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"

        android:hasFragileUserData="true"

        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.STMP">

        <!--
          GPU acceleration for LiteRT-LM REQUIRES these declarations (verified on device
          2026-10-19). Without them the app cannot see the vendor OpenCL driver, the GPU
          sampler fails to load, and inference dies with
          `Can not find OpenCL library on this device` — even though the engine itself
          initialises and reports `engine on GPU`. The failure is at INFERENCE time, not
          load time, which is what made it look like a slow model rather than a missing
          library.

          `required="false"` on purpose: these are VENDOR libraries, present on most real
          devices (Samsung/Qualcomm/MediaTek ship an OpenCL driver) but absent on some
          emulators and AOSP builds. Making them required would refuse to install there;
          leaving them optional means a device without them installs and simply falls back
          to CPU, which LiteRtLm handles explicitly and logs.

          `libvndksupport.so` is declared alongside because the vendor OpenCL driver links
          against it; without it the driver still fails to dlopen.
        -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ApprovalActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:showOnLockScreen="true"
            android:theme="@style/Theme.STMP.Approval" />

        <activity
            android:name=".GoogleLoginActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".LogActivity"
            android:exported="false" />

        <activity
            android:name=".LogDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ExceptionsActivity"
            android:exported="false" />

        <activity
            android:name=".OptionsActivity"
            android:exported="false" />

        <!-- "How do I use this?" — a copyable starting prompt for any agent, plus what to
             expect. No API documentation: /help serves that, live. -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />

        <!-- The caller-naming prompt. Full-screen, triggered by an unnamed address's first
             request; writes callers.json and releases the waiting request. -->
        <activity
            android:name=".CallerActivity"
            android:exported="false" />

        <activity
            android:name=".SshActivity"
            android:exported="false" />

        <!-- Secret CRUD. Sets FLAG_SECURE itself, so no screenshots of a value. -->
        <activity
            android:name=".SecretsActivity"
            android:exported="false" />

 <!-- exported=false: plugins are addressed via the in-app registry, not by intent -->
        <service
            android:name=".BridgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent local HTTP bridge server that must stay reachable for inbound requests; it is not a sync or media job and cannot be scheduled." />
        </service>

        <!--
          Auto-start after a reboot or an app update.

          `exported="true"` is REQUIRED and is not a hole: BOOT_COMPLETED and
          MY_PACKAGE_REPLACED are protected broadcasts that only the system can send, so no
          other app can invoke this receiver. A non-exported receiver is simply never
          delivered these actions, which is why the bridge could not come back after the
          2026-10-25 reboot.

          No `directBootAware`: the policy file lives in credential-encrypted storage, so a
          LOCKED_BOOT_COMPLETED start would run before it can be read. The receiver filters to
          the two actions it can honour.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".NotifListenerService"
            android:exported="true"
            android:label="STMP Notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
